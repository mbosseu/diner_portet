# ==========================================================
# Business Club · Dîner du 4 décembre — variables d'environnement
# En local : copier ce fichier en ".env". En ligne : les saisir dans Vercel.
# Mêmes noms de variables que la boutique Box Plus : les valeurs CAWL et Brevo
# se recopient depuis Vercel → projet box-plus → Settings → Environment Variables.
# ==========================================================

# Adresse publique du site (facultatif en ligne : https://dinerportet.vercel.app par défaut)
PUBLIC_URL=https://dinerportet.vercel.app

# ---------- Prestataire de paiement ----------
# paypal (par défaut) ou cawl.
PAYMENT_PROVIDER=paypal

# ---------- Paiement PayPal — compte PayPal de Portet ----------
# Mêmes noms que Box Plus : PAYPAL_PORTET_* est prioritaire (dans Box Plus, PAYPAL_CLIENT_ID = Minimes).
# PAYPAL_MODE=live → vrais paiements · PAYPAL_MODE=sandbox → bac à sable
PAYPAL_MODE=live
PAYPAL_PORTET_CLIENT_ID=
PAYPAL_PORTET_CLIENT_SECRET=
# Webhook (facultatif, recommandé) à déclarer dans l'app PayPal : {PUBLIC_URL}/api/webhooks/paypal
# Événements : Checkout order approved, Payment capture completed / denied
# Clés sandbox (facultatif) : utilisées uniquement dans le Studio. Sinon : simulateur PayPal intégré.
PAYPAL_TEST_PORTET_CLIENT_ID=
PAYPAL_TEST_PORTET_CLIENT_SECRET=

# ---------- Paiement CAWL (Crédit Agricole / Worldline) — compte de Portet ----------
# CAWL_MODE=live → vrais paiements (payment.cawl-solutions.fr)
# CAWL_MODE=test → préproduction (payment.preprod.cawl-solutions.fr)
CAWL_MODE=live
CAWL_MERCHANT_ID=
CAWL_API_KEY_ID=
CAWL_API_SECRET=
# Webhook à déclarer dans le portail CAWL : {PUBLIC_URL}/api/webhooks/cawl

# Clés de TEST CAWL (facultatif) : utilisées uniquement dans le Studio.
# Sans elles, le Studio utilise son simulateur CAWL intégré.
CAWL_TEST_MERCHANT_ID=
CAWL_TEST_API_KEY_ID=
CAWL_TEST_API_SECRET=

# ---------- E-mails Brevo ----------
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
# Nom d'expéditeur et réponse propres au dîner (BREVO_SENDER_NAME / BREVO_REPLY_TO de la boutique sont ignorés)
DINER_SENDER_NAME=Business Club · Boxing Center
DINER_REPLY_TO=boxingcenter31@gmail.com
# Copie de chaque nouvelle inscription pour l'organisateur (facultatif)
ORGANIZER_EMAIL=

# ---------- Enregistrement des inscriptions ----------
# Supabase : un projet DÉDIÉ au dîner (pas celui de la boutique). Exécuter supabase/schema.sql.
# Sans ces variables, les inscriptions sont écrites dans data/registrations (local uniquement).
# Préfixe DINER_ obligatoire : SUPABASE_URL (base de la boutique) est volontairement ignoré.
DINER_SUPABASE_URL=
DINER_SUPABASE_SERVICE_ROLE_KEY=

# ---------- Jauge ----------
# Places payantes (les 10 invitations partenaires sont gérées à part)
MAX_PAID_SEATS=60

# ---------- Sécurité ----------
# CRON_SECRET : protège le rappel automatique (Vercel l'utilise tout seul)
# ADMIN_TOKEN : accès à la liste des inscrits (/api/admin/registrations?format=csv&token=…)
# STUDIO_PASSWORD : ouvre le Studio en ligne (/studio). Sans mot de passe, le Studio est fermé en production.
CRON_SECRET=
ADMIN_TOKEN=
STUDIO_PASSWORD=

# 1 = les e-mails des tests du Studio partent vraiment via Brevo (sinon : boîte d'envoi du Studio)
STUDIO_SEND_REAL_EMAILS=0
