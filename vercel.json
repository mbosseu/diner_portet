{
  "version": 2,
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/studio/pay/(.*)",
      "destination": "/api"
    },
    {
      "source": "/studio/paypal/(.*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "server/**"
    }
  },
  "crons": [
    {
      "path": "/api/cron/reminder",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/reminder-retry",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/reminder-last",
      "schedule": "0 17 * * *"
    }
  ]
}
